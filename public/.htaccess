# ---- Force HTTPS and non-www (canonical is https://ulendotours.co.za) ----
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Serve clean URLs (e.g. /pay, /terms, /pay/success) as their matching .html
  # file. build.format: "file" in astro.config.mjs emits pay.html rather than
  # pay/index.html, and this saves relying on mod_negotiation's MultiViews
  # (not guaranteed enabled on every cPanel/EasyApache build) to resolve it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# ---- Custom error page ----
ErrorDocument 404 /404.html

# ---- Never serve config or log files ----
# Belt-and-braces only: yoco-config.php lives ABOVE public_html and log files are
# written above public_html too, so neither should ever be reachable via this
# document root regardless. This just guards against either ending up here by
# mistake (e.g. during local testing). Matches the literal filename ending, not
# a bare substring, so it actually catches "yoco-config.php" and "*.log".
<FilesMatch "(yoco-config\.php|\.log)$">
  Require all denied
</FilesMatch>

# ---- Protect the link generator ----
<Files "generate-link.php">
  AuthType Basic
  AuthName "Ulendo Admin"
  AuthUserFile /home/USERNAME/.htpasswd
  Require valid-user
</Files>

# ---- MIME types (older cPanel Apache builds miss these) ----
<IfModule mod_mime.c>
  AddType image/webp                  .webp
  AddType image/svg+xml               .svg
  AddType font/woff2                  .woff2
  AddType application/manifest+json   .webmanifest
</IfModule>

# ---- Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# ---- Caching ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                      "access plus 1 month"
  ExpiresByType text/html             "access plus 0 seconds"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# Astro fingerprints everything in /_astro/, so it's safe to cache hard
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|jpg|jpeg|webp|svg|png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---- Don't serve dotfiles ----
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

Options -Indexes
