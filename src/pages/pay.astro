---
import Layout from "../layouts/Layout.astro";
import { whatsapp } from "../config/links";
---

<Layout title="Secure your booking | Ulendo Tours" noindex>
  <section class="flex min-h-[80vh] items-center justify-center bg-green-900 px-5 py-24">
    <div class="w-full max-w-[560px]">
      <div data-pay-loading class="rounded-card bg-cream-100 p-8 text-center text-green-900 md:p-10">
        <p class="text-sm text-green-700/70">Loading your booking…</p>
      </div>

      <div data-pay-form class="hidden rounded-card bg-cream-100 p-8 md:p-10">
        <img src="/brand/mark-green.svg" alt="Ulendo Tours" width="39" height="35" class="h-10 w-auto" />
        <h1 class="mt-6 text-2xl font-bold text-green-900">Secure your booking</h1>

        <p class="mt-6 text-eyebrow-mobile uppercase text-green-700/60">Booking reference</p>
        <p data-ref class="font-mono text-lg text-green-900"></p>

        <p data-desc-line class="mt-4 text-sm text-green-700/80"></p>

        <p class="mt-6 text-eyebrow-mobile uppercase text-green-700/60">Amount due</p>
        <p data-amount class="text-4xl font-bold text-green-900"></p>

        <div class="mt-6 rounded-xl bg-green-900/5 p-4">
          <p class="text-sm font-semibold text-green-900">What this covers</p>
          <p data-desc-breakdown class="mt-1 text-sm text-green-700/80"></p>
        </div>

        <label class="mt-6 flex items-start gap-3 text-sm text-green-700">
          <input type="checkbox" data-terms-checkbox class="mt-1 h-4 w-4 shrink-0 accent-orange-500" />
          <span>
            I have read and accept the
            <a href="/terms" target="_blank" rel="noopener noreferrer" class="font-semibold underline">
              Terms &amp; Conditions
            </a>
          </span>
        </label>

        <button type="button" data-pay-button disabled class="btn-primary press mt-6 w-full">
          Pay securely with Yoco
        </button>
        <p data-pay-error class="mt-3 hidden text-sm text-red-600"></p>

        <p class="mt-5 text-center text-xs text-green-700/60">
          Payments are processed by Yoco. Ulendo Tours never sees or stores your card details.
        </p>
      </div>

      <div data-pay-error-state class="hidden rounded-card bg-cream-100 p-8 text-center text-green-900 md:p-10">
        <h1 class="text-2xl font-bold">Link invalid or expired</h1>
        <p class="mt-3 text-sm text-green-700/80">
          This payment link is invalid or has expired. Please contact us on WhatsApp for a new one.
        </p>
        <a
          href={whatsapp("general")}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary press mt-6 inline-flex"
        >
          Chat to Us
        </a>
      </div>
    </div>
  </section>
</Layout>

<script src="../scripts/pay.js"></script>
