---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Flights from "../components/Flights.astro";
import Stays from "../components/Stays.astro";
import Experiences from "../components/Experiences.astro";
import Nights from "../components/Nights.astro";
import Packages from "../components/Packages.astro";
import HowItWorks from "../components/HowItWorks.astro";
import FinalCta from "../components/FinalCta.astro";
---

<Layout>
  <div class="stack-frame" style={{ "--stack-z": 10 }}>
    <div class="stack-sticky">
      <Hero />
    </div>
  </div>
  <div class="stack-frame" style={{ "--stack-z": 20 }}>
    <div class="stack-sticky">
      <About />
    </div>
  </div>
  <div class="stack-frame" style={{ "--stack-z": 30 }}>
    <div class="stack-sticky">
      <Flights />
    </div>
  </div>
  <div class="stack-frame" style={{ "--stack-z": 40 }}>
    <div class="stack-sticky">
      <Stays />
    </div>
  </div>
  <div class="stack-frame stack-frame-last" style={{ "--stack-z": 50 }}>
    <div class="stack-sticky">
      <Experiences />
    </div>
  </div>
  <Nights />
  <Packages />
  <HowItWorks />
  <FinalCta />
</Layout>
