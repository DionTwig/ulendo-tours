---
import { whatsapp } from "../config/links";
---

<section
  id="hero"
  aria-labelledby="hero-heading"
  class="relative flex h-[100svh] min-h-[640px] items-end overflow-hidden bg-green-900"
>
  <div data-hero-parallax class="absolute left-0 right-0 h-[120%] w-full" style="top: -10%;">
    <picture>
      <source srcset="/images/hero.webp" type="image/webp" />
      <img
        src="/images/hero.jpg"
        alt="Aerial view of a beach house among palm trees with a small aircraft, framing a Southern Africa getaway"
        width="2400"
        height="1340"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        class="hero-image h-full w-full object-cover"
      />
    </picture>
  </div>

  <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto w-full max-w-content px-5 pb-16 md:px-gutter md:pb-20">
    <div class="max-w-xl">
      <h1
        id="hero-heading"
        data-hero-anim
        class="anim-item delay-0 text-h1-mobile text-cream-100 tracking-tight md:text-h1-desktop"
      >
        Crafting Unforgettable <span class="accent-italic">Experiences</span>
      </h1>
      <p data-hero-anim class="anim-item delay-1 mt-5 max-w-md text-body-mobile text-cream-100/85 md:text-body-desktop">
        Discounted flights, curated stays, and trips across Southern Africa — planned around how you actually travel.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href={whatsapp("general")}
          target="_blank"
          rel="noopener noreferrer"
          data-hero-anim
          class="anim-item delay-2 btn-primary press"
        >
          Plan My Trip
        </a>
        <a href="#how-it-works" data-hero-anim class="anim-item delay-2 btn-secondary press">See What We Do</a>
      </div>

      <div
        data-hero-anim
        class="anim-item delay-3 mt-8 inline-flex items-center gap-2.5 rounded-pill bg-cream-100/90 px-5 py-3 text-sm font-semibold text-green-900 backdrop-blur-sm"
      >
        <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-orange-500" aria-hidden="true"></span>
        Save up to 40% on flights, stay and experiences
      </div>
    </div>
  </div>
</section>

<style>
  .hero-image {
    object-position: 100% center;
    opacity: 0;
    transform: scale(1.06);
    animation: hero-settle 1400ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @media (min-width: 1024px) {
    .hero-image {
      object-position: center;
    }
  }

  .hero-scrim {
    background: linear-gradient(to top, rgba(10, 58, 49, 0.92) 0%, rgba(10, 58, 49, 0) 65%);
  }

  @media (min-width: 768px) {
    .hero-scrim {
      background: linear-gradient(
        to right,
        rgba(10, 58, 49, 0.85) 0%,
        rgba(10, 58, 49, 0.4) 44%,
        rgba(10, 58, 49, 0) 75%
      );
    }
  }

  @keyframes hero-settle {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .anim-item {
    opacity: 0;
    transform: translateY(20px);
    animation: hero-in 700ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* The delay is the whole effect: copy starts at 900ms, while the hero media
     (1400ms entrance) is still settling — not after it finishes. */
  .delay-0 {
    animation-delay: 900ms;
  }
  .delay-1 {
    animation-delay: 1020ms;
  }
  .delay-2 {
    animation-delay: 1140ms;
  }
  .delay-3 {
    animation-delay: 1260ms;
  }

  @keyframes hero-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image {
      animation: none;
      opacity: 1;
      transform: scale(1);
    }
    .anim-item {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script src="../scripts/hero-video.js"></script>
