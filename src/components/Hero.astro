---
import { whatsapp } from "../config/links";
---

<section
  id="hero"
  aria-labelledby="hero-heading"
  class="relative flex h-[100svh] min-h-[640px] items-end overflow-hidden bg-green-900 md:items-center"
>
  <div data-hero-parallax class="absolute inset-0 h-[120%] w-full">
    <picture>
      <source srcset="/images/hero.webp" type="image/webp" />
      <img
        src="/images/hero.jpg"
        alt="Aerial view of a beach house among palm trees with a small aircraft, framing a Southern Africa getaway"
        width="2400"
        height="1340"
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        class="hero-image h-full w-full object-cover"
      />
    </picture>
  </div>

  <div class="hero-scrim absolute inset-0" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto w-full max-w-content px-5 pb-28 md:px-gutter md:pb-32">
    <div class="max-w-xl">
      <p data-hero-anim class="eyebrow anim-item">Johannesburg &middot; Southern Africa</p>
      <h1
        id="hero-heading"
        data-hero-anim
        class="anim-item mt-4 text-h1-mobile text-cream-100 tracking-tight md:text-h1-desktop"
      >
        Crafting Unforgettable <span class="accent-italic">Experiences</span>
      </h1>
      <p data-hero-anim class="anim-item mt-5 max-w-md text-body-mobile text-cream-100/85 md:text-body-desktop">
        We plan flights, stays and experiences across Southern Africa, then hand you a plan — not a login. Real people, one WhatsApp chat away.
      </p>
      <div data-hero-anim class="anim-item mt-8 flex flex-wrap items-center gap-4">
        <a href={whatsapp("general")} target="_blank" rel="noopener noreferrer" class="btn-primary">
          Chat on WhatsApp
        </a>
        <a href="#how-it-works" class="btn-secondary">How it works</a>
      </div>
      <p data-hero-anim class="anim-item mt-6 text-sm text-cream-100/70">
        No accounts. No booking engine. Just people who know the region.
      </p>
    </div>
  </div>
</section>

<style>
  .hero-image {
    object-position: 100% center;
    transform: scale(1.06);
    animation: hero-settle 1.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @media (min-width: 1024px) {
    .hero-image {
      object-position: center;
    }
  }

  .hero-scrim {
    background: linear-gradient(to top, rgba(10, 58, 49, 0.92) 0%, rgba(10, 58, 49, 0) 65%);
  }

  @media (min-width: 768px) {
    .hero-scrim {
      background: linear-gradient(
        to right,
        rgba(10, 58, 49, 0.85) 0%,
        rgba(10, 58, 49, 0.4) 45%,
        rgba(10, 58, 49, 0) 75%
      );
    }
  }

  @keyframes hero-settle {
    to {
      transform: scale(1);
    }
  }

  .anim-item {
    opacity: 0;
    transform: translateY(20px);
    animation: hero-in 700ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .anim-item:nth-child(1) {
    animation-delay: 0ms;
  }
  .anim-item:nth-child(2) {
    animation-delay: 120ms;
  }
  .anim-item:nth-child(3) {
    animation-delay: 240ms;
  }
  .anim-item:nth-child(4) {
    animation-delay: 360ms;
  }
  .anim-item:nth-child(5) {
    animation-delay: 480ms;
  }

  @keyframes hero-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-image {
      animation: none;
      transform: scale(1);
    }
    .anim-item {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script src="../scripts/hero-parallax.js"></script>
