---
import { whatsapp } from "../config/links";

const navLinks = [
  { href: "#about", label: "About" },
  { href: "#flights", label: "Flights" },
  { href: "#stays", label: "Stay" },
  { href: "#experiences", label: "Experiences" },
  { href: "#nights", label: "Nightlife" },
];
---

<header
  data-nav
  class="fixed inset-x-0 top-8 z-50 mx-auto flex w-[calc(100%-40px)] max-w-content items-center justify-between rounded-pill px-4 py-3 transition-transform duration-300 ease-smooth md:px-6 md:py-4"
  style="background-color: rgba(10, 58, 49, 0.55); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px);"
>
  <a href="#main" class="flex items-center gap-2" aria-label="Ulendo Tours home">
    <img src="/brand/logo-cream.svg" alt="Ulendo Tours" class="h-10 w-auto md:h-12" width="174" height="65" />
  </a>

  <nav aria-label="Primary" class="hidden lg:block">
    <ul class="flex items-center gap-8">
      {
        navLinks.map((item) => (
          <li>
            <a href={item.href} class="nav-link relative text-sm font-medium text-cream-100/90 transition-colors hover:text-cream-100">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="flex items-center gap-3">
    <a
      href={whatsapp("general")}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden md:inline-flex btn-primary !px-5 !py-2.5 text-sm"
    >
      Let's Craft
    </a>
    <a
      href={whatsapp("general")}
      target="_blank"
      rel="noopener noreferrer"
      class="press md:hidden inline-flex items-center justify-center rounded-pill bg-orange-500 px-4 py-2 text-sm font-semibold text-white"
    >
      Let's Craft
    </a>
    <button
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle menu"
      class="menu-toggle-btn lg:hidden relative inline-flex h-10 w-10 items-center justify-center rounded-full text-cream-100"
    >
      <svg
        class="icon-menu"
        width="22"
        height="16"
        viewBox="0 0 22 16"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path d="M0 1H22" stroke="currentColor" stroke-width="2" />
        <path d="M0 8H22" stroke="currentColor" stroke-width="2" />
        <path d="M0 15H22" stroke="currentColor" stroke-width="2" />
      </svg>
      <svg
        class="icon-close"
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <path d="M1 1L15 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        <path d="M15 1L1 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
  </div>
</header>

<div
  id="mobile-menu"
  data-mobile-menu
  class="mobile-menu fixed inset-0 z-40 flex flex-col items-center justify-center gap-8 bg-green-900 lg:hidden"
>
  <nav aria-label="Mobile">
    <ul class="flex flex-col items-center gap-6">
      {
        navLinks.map((item) => (
          <li>
            <a href={item.href} class="text-2xl font-semibold text-cream-100">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <a href={whatsapp("general")} target="_blank" rel="noopener noreferrer" class="btn-primary press">
    Lets Chat..
  </a>
</div>

<div data-scroll-progress class="scroll-progress fixed inset-x-0 top-0 z-[60] h-[3px] origin-left bg-orange-500" aria-hidden="true"></div>

<style>
  [data-nav].nav-hidden {
    transform: translateY(-120%);
  }

  @supports not (backdrop-filter: blur(1px)) {
    [data-nav] {
      background-color: #0a3a31;
    }
  }

  .mobile-menu {
    opacity: 0;
    visibility: hidden;
    transition: opacity 300ms ease, visibility 300ms ease;
  }

  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -4px;
    width: 100%;
    height: 2px;
    background-color: #f15c22;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 250ms ease;
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
  }

  .scroll-progress {
    transform: scaleX(0);
  }

  .icon-menu,
  .icon-close {
    position: absolute;
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .icon-close {
    opacity: 0;
    transform: scale(0.7);
  }

  .menu-toggle-btn[aria-expanded="true"] .icon-menu {
    opacity: 0;
    transform: scale(0.7);
  }

  .menu-toggle-btn[aria-expanded="true"] .icon-close {
    opacity: 1;
    transform: scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-progress {
      display: none;
    }
    .nav-link::after {
      transition: none;
    }
    .icon-menu,
    .icon-close {
      transition: none;
    }
  }
</style>

<script src="../scripts/nav.js"></script>
