---
import ResponsiveImage from "./ResponsiveImage.astro";
import { whatsapp } from "../config/links";

const includes = [
  "Return flights, Johannesburg to Cape Town",
  "Beach view luxury stay",
  "One signature Ulendo experience",
];
---

<section id="packages" aria-labelledby="packages-heading" class="bg-cream-100 py-20 md:py-28">
  <div class="mx-auto max-w-content px-5 md:px-gutter">
    <p data-reveal class="reveal eyebrow">Packages</p>
    <h2
      id="packages-heading"
      data-reveal
      class="reveal mt-4 max-w-2xl text-h2-mobile text-green-900 tracking-tight md:text-h2-desktop"
    >
      Already built.<br /><span class="accent-italic">Just pack a bag.</span>
    </h2>

    <div
      data-reveal
      data-reveal-from="scale"
      class="package-card reveal mt-12 grid grid-cols-1 overflow-hidden rounded-card bg-white shadow-lg shadow-green-900/5 md:mt-16 md:grid-cols-2"
    >
      <div class="overflow-hidden">
        <ResponsiveImage
          src="/images/exp-couples"
          alt="Couple relaxing together on a scenic Cape Town getaway, featured in the Cape Town Long Weekend package"
          width={1200}
          height={769}
          class="package-card-image h-64 w-full object-cover md:h-full"
          loading="lazy"
        />
      </div>

      <div class="flex flex-col justify-center p-7 md:p-12">
        <p class="eyebrow">Featured package</p>
        <h3 class="mt-3 text-h3-mobile text-green-900 md:text-3xl md:font-bold">Cape Town Long Weekend</h3>
        <p class="mt-3 text-sm text-green-700/80 md:text-base">
          Four days, three nights. Flights, a boutique stay and one signature experience — planned end to end.
        </p>

        <ul class="mt-6 flex flex-col gap-2.5">
          {
            includes.map((item) => (
              <li class="flex items-start gap-3 text-sm text-green-700/85">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-orange-500" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>

        <div class="mt-8 flex flex-wrap items-baseline gap-2">
          <span class="text-3xl font-bold text-green-900">R8 500</span>
          <span class="text-sm text-green-700/70">pp, sharing</span>
        </div>
        <p class="mt-1 text-xs text-green-700/50">Placeholder pricing — to be confirmed by Ulendo before launch.</p>

        <div class="mt-7 flex flex-wrap gap-4">
          <a href={whatsapp("packages")} target="_blank" rel="noopener noreferrer" class="btn-primary press">
            Enquire on WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .package-card {
    transition: transform 500ms ease-out, box-shadow 500ms ease-out;
  }

  .package-card-image {
    transition: transform 500ms ease-out;
  }

  .package-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(10, 58, 49, 0.15);
  }

  .package-card:hover .package-card-image {
    transform: scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .package-card,
    .package-card-image {
      transition: none;
    }
    .package-card:hover {
      transform: none;
    }
    .package-card:hover .package-card-image {
      transform: none;
    }
  }
</style>
