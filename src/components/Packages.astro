---
import ResponsiveImage from "./ResponsiveImage.astro";
import packagesData from "../data/packages.json";

const { packages } = packagesData;

const cardImageBySlug: Record<string, string> = {
  "cape-town": "/images/package-cape-town",
  durban: "/images/durban",
  zanzibar: "/images/zanzibar",
  bilene: "/images/bilene",
};
const fallbackImage = "/images/stays";

const steps = [
  {
    number: "01",
    title: "Choose your destination",
    body: "Four cities. Prices shift with the airport you fly from.",
  },
  {
    number: "02",
    title: "Pick two experiences",
    body: "Each package comes with a shortlist of five. You choose two.",
  },
  {
    number: "03",
    title: "Flexible payments",
    body: "Secure your seats with a deposit, then settle the balance in monthly instalments.",
  },
];
---

<section id="packages" aria-labelledby="packages-heading" class="pkg-scope">
  <!-- Billboard -->
  <div class="relative overflow-hidden bg-[var(--green-900)] py-20 md:py-28">
    <div class="absolute inset-0">
      <ResponsiveImage
        src="/images/flights"
        alt=""
        width={1800}
        height={1005}
        class="h-full w-full object-cover opacity-50"
        loading="lazy"
      />
      <div class="pkg-billboard-scrim absolute inset-0" aria-hidden="true"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-content px-5 text-center md:px-gutter">
      <span
        class="inline-flex items-center rounded-[100px] bg-[var(--orange-500)] px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.10em] text-white"
      >
        Limited-Time Launch Packages
      </span>
      <h2
        id="packages-heading"
        class="mx-auto mt-5 max-w-2xl text-[46px] font-bold leading-[1.05] tracking-[-0.03em] text-[var(--cream-100)] md:text-[64px]"
      >
        Return flights, your stay, and two experiences you pick.
      </h2>
      <p class="mx-auto mt-4 max-w-lg text-[15px] leading-[1.55] text-[rgba(239,245,207,0.8)] md:text-[16px]">
        Four destinations, priced per couple. Departing Johannesburg, Cape Town, Durban and Gqeberha.
      </p>

      <div
        class="mx-auto mt-10 grid max-w-3xl grid-cols-1 divide-y divide-[rgba(239,245,207,0.15)] text-left md:grid-cols-3 md:divide-x md:divide-y-0"
      >
        {
          steps.map((step) => (
            <div class="py-5 first:pt-0 last:pb-0 md:px-7 md:py-0 md:first:pl-0 md:last:pr-0">
              <p class="text-[11px] font-semibold uppercase tracking-[0.10em] text-[var(--orange-500)]">
                {step.number}
              </p>
              <p class="mt-1.5 text-[15px] font-semibold text-[var(--cream-100)] md:text-[16px]">{step.title}</p>
              <p class="mt-1.5 text-sm leading-[1.55] text-[rgba(239,245,207,0.75)]">{step.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Catalog -->
  <div class="bg-[var(--blue-100)] px-5 py-16 md:px-gutter md:py-24">
    <div class="mx-auto max-w-content">
      <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="block text-[11px] font-semibold uppercase tracking-[0.10em] text-[var(--orange-500)] md:text-[13px]">
            The Packages
          </p>
          <h3 class="mt-4 max-w-2xl text-h2-mobile tracking-[-0.03em] text-[var(--ink-900)] md:text-h2-desktop">
            Four trips, just pick one.
          </h3>
        </div>
        <p class="max-w-xs text-[15px] leading-[1.55] text-[var(--ink-500)] md:text-[16px]">
          Prices shown are per couple flying from Johannesburg. Other departure cities are priced at checkout.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 items-stretch gap-6 md:mt-16 md:grid-cols-2 min-[1200px]:grid-cols-4">
        {
          packages.map((pkg) => {
            const price = pkg.pricePerCoupleByOrigin.jnb;
            const priceFormatted = new Intl.NumberFormat("en-ZA", { maximumFractionDigits: 0 }).format(price);
            return (
              <a
                href={`/packages/${pkg.slug}`}
                class="pkg-card group flex flex-col overflow-hidden rounded-[24px] border border-[var(--green-050)] bg-white transition-transform duration-300 hover:-translate-y-1"
              >
                <div class="relative aspect-[16/10] w-full overflow-hidden">
                  <ResponsiveImage
                    src={cardImageBySlug[pkg.slug] ?? fallbackImage}
                    alt={`${pkg.name}, ${pkg.area}`}
                    width={640}
                    height={400}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                  <span class="absolute left-4 top-4 rounded-[100px] bg-[var(--green-900)] px-3 py-1 text-[11px] font-semibold uppercase tracking-[0.10em] text-[var(--cream-100)]">
                    {pkg.nights} Nights
                  </span>
                </div>

                <div class="flex flex-1 flex-col p-6">
                  <h4 class="text-[20px] font-bold tracking-[-0.03em] text-[var(--ink-900)]">{pkg.name}{
                    pkg.region !== "South Africa" && (
                      <span class="font-normal text-[var(--ink-500)]">, {pkg.region}</span>
                    )
                  }</h4>
                  <p class="mt-1 text-sm text-[var(--ink-500)]">{pkg.cardSubtitle}</p>

                  <ul class="mt-4 flex flex-col gap-2">
                    {pkg.includes.slice(0, 3).map((item) => (
                      <li class="flex items-start gap-2.5 text-sm text-[var(--ink-500)]">
                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--green-900)]" aria-hidden="true" />
                        <span>{item.title}</span>
                      </li>
                    ))}
                  </ul>

                  <div class="mt-auto pt-6">
                    <div class="flex items-baseline gap-2 border-t border-[var(--green-050)] pt-4">
                      <span class="text-[11px] font-semibold uppercase tracking-[0.10em] text-[var(--ink-500)]">
                        From
                      </span>
                      <span class="text-[22px] font-bold tracking-[-0.03em] text-[var(--green-900)]">
                        R{priceFormatted}
                      </span>
                      <span class="text-sm text-[var(--ink-500)]">per couple</span>
                    </div>
                    <span class="btn mt-4 w-full bg-[var(--green-900)] text-white transition-colors group-hover:bg-[var(--orange-500)]">
                      View Package
                    </span>
                  </div>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </div>
</section>

<style>
  .pkg-billboard-scrim {
    background: linear-gradient(
      to top,
      rgba(14, 87, 74, 0.95) 0%,
      rgba(14, 87, 74, 0.75) 55%,
      rgba(14, 87, 74, 0.55) 100%
    );
  }

  @media (prefers-reduced-motion: reduce) {
    .pkg-card,
    .pkg-card * {
      transition: none !important;
    }
    .pkg-card:hover {
      transform: none !important;
    }
  }
</style>
