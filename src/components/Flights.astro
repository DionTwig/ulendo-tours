---
import ResponsiveImage from "./ResponsiveImage.astro";
import { whatsapp } from "../config/links";

const bullets = [
  "Domestic, regional and international routes",
  "Flexible-date sourcing for the best fare",
  "Group bookings handled as one conversation",
];
---

<section id="flights" aria-labelledby="flights-heading" class="bg-white py-20 md:py-28">
  <div class="mx-auto max-w-content px-5 md:px-gutter">
    <div
      data-reveal
      data-reveal-from="scale"
      class="reveal relative h-[620px] overflow-hidden rounded-card md:h-[480px]"
    >
      <ResponsiveImage
        src="/images/flights"
        alt="Woman looking out of an aircraft window at Table Mountain and the Cape Town coastline below"
        width={1800}
        height={1005}
        class="absolute inset-0 h-full w-full object-cover"
        loading="lazy"
        drift
      />

      <div class="absolute inset-0 flex items-end justify-center p-5 md:items-center md:justify-end md:p-0 md:pr-16">
        <div class="frost-panel w-full md:w-auto md:max-w-[440px]">
          <p class="eyebrow">Flights</p>
          <h2 id="flights-heading" class="mt-4 text-h2-mobile text-green-900 tracking-tight md:text-h2-desktop">
            Get there for less. <span class="accent-italic">up to 40% off flights.</span>
          </h2>
          <p class="mt-4 text-sm leading-[1.6] text-green-700/90">
            We source discounted flights across domestic, regional and international routes — often up to 40% below
            the fares you'll find searching on your own.
          </p>
          <ul class="mt-6 flex flex-col gap-3">
            {
              bullets.map((bullet) => (
                <li class="flex items-start gap-3">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-orange-500" aria-hidden="true" />
                  <span class="text-sm text-green-700 md:text-base">{bullet}</span>
                </li>
              ))
            }
          </ul>
          <a
            href={whatsapp("flights")}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary press mt-7 inline-flex"
          >
            Let's Book
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
