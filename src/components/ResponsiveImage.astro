---
interface Props {
  src: string; // e.g. "/images/hero" — extension omitted, both .webp and .jpg must exist
  alt: string;
  width: number;
  height: number;
  class?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  sizes?: string;
}

const {
  src,
  alt,
  width,
  height,
  class: className,
  loading = "lazy",
  fetchpriority = "auto",
  sizes,
} = Astro.props;
---

<picture>
  <source srcset={`${src}.webp`} type="image/webp" />
  <img
    src={`${src}.jpg`}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding={loading === "eager" ? "sync" : "async"}
    sizes={sizes}
    class={className}
  />
</picture>
