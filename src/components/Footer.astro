---
import { links, whatsapp } from "../config/links";

const year = new Date().getFullYear();

const columns = [
  {
    heading: "Explore",
    links: [
      { label: "About", href: "#about" },
      { label: "Experiences", href: "#experiences" },
      { label: "Ulendo Nights", href: "#nights" },
      { label: "Packages", href: "#packages" },
      { label: "Terms & Conditions", href: "/terms" },
    ],
  },
  {
    heading: "Plan",
    links: [
      { label: "Flights", href: "#flights" },
      { label: "Stays", href: "#stays" },
      { label: "How it works", href: "#how-it-works" },
    ],
  },
];
---

<footer class="bg-green-700 text-cream-100">
  <div class="mx-auto max-w-content px-5 py-16 md:px-gutter md:py-20">
    <div class="flex flex-col gap-12 md:flex-row md:justify-between">
      <div class="max-w-sm">
        <img src="/brand/logo-cream.svg" alt="Ulendo Tours" class="h-8 w-auto" width="174" height="65" />
        <p class="mt-5 text-lg font-semibold leading-snug">
          Crafting Unforgettable Experiences
        </p>
        <p class="mt-4 text-sm text-cream-100/75">
          Johannesburg-based. We plan flights, stays and experiences across Southern Africa, one WhatsApp conversation at a time.
        </p>
        <a href={links.email} class="mt-4 inline-block text-sm text-cream-100/85 underline decoration-cream-100/30 underline-offset-4 transition-colors hover:text-cream-100">
          bookings@ulendotours.co.za
        </a>
      </div>

      <div class="grid grid-cols-2 gap-10 sm:flex sm:gap-16">
        {
          columns.map((column) => (
            <div>
              <p class="text-eyebrow-mobile md:text-eyebrow uppercase text-cream-100/60">{column.heading}</p>
              <ul class="mt-4 flex flex-col gap-3">
                {column.links.map((item) => (
                  <li>
                    <a href={item.href} class="text-sm text-cream-100/85 transition-colors hover:text-cream-100">
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }

        <div>
          <p class="text-eyebrow-mobile md:text-eyebrow uppercase text-cream-100/60">Contact</p>
          <ul class="mt-4 flex flex-col gap-3">
            <li>
              <a
                href={whatsapp("general")}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Chat to Ulendo Tours on WhatsApp"
                class="text-sm text-cream-100/85 transition-colors hover:text-cream-100"
              >
                WhatsApp
              </a>
            </li>
            <li>
              <a
                href={links.email}
                aria-label="Email Ulendo Tours"
                class="text-sm text-cream-100/85 transition-colors hover:text-cream-100"
              >
                Email
              </a>
            </li>
            <li>
              <a
                href={links.instagram}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Ulendo Tours on Instagram"
                class="text-sm text-cream-100/85 transition-colors hover:text-cream-100"
              >
                Instagram
              </a>
            </li>
            <li>
              <a
                href={links.facebook}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Ulendo Tours on Facebook"
                class="text-sm text-cream-100/85 transition-colors hover:text-cream-100"
              >
                Facebook
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-cream-100/15 pt-8 text-xs text-cream-100/60 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} Ulendo Tours. All rights reserved.</p>
      <p>Johannesburg, South Africa</p>
    </div>
  </div>
</footer>
