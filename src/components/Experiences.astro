---
import ResponsiveImage from "./ResponsiveImage.astro";
import { whatsapp } from "../config/links";

const cards = [
  {
    key: "corporate",
    title: "Corporate & Team",
    body: "Offsites and incentive trips that don't feel like a work trip.",
    image: "/images/exp-corporate",
    alt: "Colleagues gathered outdoors during a corporate team retreat in Southern Africa",
  },
  {
    key: "girls-trip",
    title: "Girls' Trip",
    body: "Spa days, sundowners and just enough adventure to earn the photos.",
    image: "/images/exp-girls-trip",
    alt: "Group of friends laughing together on a girls' trip getaway",
  },
  {
    key: "boys-getaway",
    title: "Boys' Getaway",
    body: "Golf, game drives and long lunches — planned so nobody has to.",
    image: "/images/exp-boys-getaway",
    alt: "Group of friends on a boys' getaway trip in Southern Africa",
  },
  {
    key: "couples",
    title: "Couples' Escape",
    body: "Quiet lodges and standout dinners, built around two people.",
    image: "/images/exp-couples",
    alt: "Couple enjoying a scenic moment together on a Southern Africa escape",
  },
  {
    key: "explore-africa",
    title: "Visiting Southern Africa",
    body: "First time in the region? We'll build the route so you see it properly.",
    image: "/images/exp-explore-africa",
    alt: "Scenic Southern African landscape showcasing the region for first-time visitors",
  },
];
---

<div class="exp-frame" data-experiences-pin>
  <div class="exp-pin">
    <section
      id="experiences"
      aria-labelledby="experiences-heading"
      class="exp-section flex h-full flex-col justify-center py-20 md:py-0"
    >
      <div class="mx-auto w-full max-w-content px-5 md:px-gutter">
        <p data-reveal class="reveal eyebrow">Experiences</p>
        <h2
          id="experiences-heading"
          data-reveal
          class="reveal mt-4 max-w-2xl text-h2-mobile text-cream-100 tracking-tight md:text-h2-desktop"
        >
          The trip is the easy part.<br />The experience is what we <span class="accent-italic">craft.</span>
        </h2>
        <p data-reveal class="reveal mt-4 max-w-2xl text-sm text-cream-100/75 md:text-base">
          Anyone can find you a flight. What we do is design the days around it — the places, the timing, the pace.
          Starting in South Africa, expanding across Africa.
        </p>

        <div class="mt-8 hidden h-1 w-full overflow-hidden rounded-full bg-cream-100/15 md:block" role="presentation">
          <div data-experiences-progress-fill class="h-full w-full origin-left scale-x-0 bg-orange-500"></div>
        </div>

        <div class="exp-scroller mt-8 md:mt-10">
          <div data-experiences-track class="exp-track">
            {
              cards.map((card) => (
                <a
                  href={whatsapp("experiences")}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="exp-card group block"
                >
                  <div class="relative">
                    <div class="overflow-hidden">
                      <ResponsiveImage
                        src={card.image}
                        alt={card.alt}
                        width={640}
                        height={480}
                        class="exp-card-image aspect-[4/3] w-full object-cover"
                        loading="lazy"
                      />
                    </div>
                    <h3 class="exp-pill absolute bottom-0 left-5 z-10 translate-y-1/2">{card.title}</h3>
                  </div>
                  <div class="exp-card-body px-5 pb-5">
                    <p class="text-sm text-green-700/90">{card.body}</p>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<style>
  /* The frame is a tall scroll runway; the pin is the fixed 100vh stage the
     horizontal track animates inside. Desktop only — mobile stays a normal
     flow section with its own native horizontal scroller. */
  @media (min-width: 768px) {
    .exp-frame {
      position: relative;
      height: 260vh;
    }

    .exp-pin {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .exp-frame {
      height: auto !important;
    }

    .exp-pin {
      position: static !important;
    }
  }

  .exp-section {
    background: linear-gradient(180deg, #0a3a31 0%, #0e574a 100%);
  }

  .exp-scroller {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .exp-scroller::-webkit-scrollbar {
    display: none;
  }

  .exp-track {
    display: flex;
    gap: 20px;
    width: max-content;
  }

  .exp-card {
    flex: 0 0 78vw;
    max-width: 340px;
    scroll-snap-align: start;
    background-color: #eff5cf;
    border-radius: 28px;
    overflow: hidden;
    transition: transform 500ms ease-out;
  }

  .exp-card-image {
    transition: transform 500ms ease-out;
  }

  .exp-card:hover {
    transform: translateY(-6px);
    filter: drop-shadow(0 12px 24px rgba(10, 58, 49, 0.15));
  }

  .exp-card:hover .exp-card-image {
    transform: scale(1.05);
  }

  .exp-pill {
    background-color: #f15c22;
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    padding: 10px 18px;
    border-radius: 999px;
    box-shadow: 0 4px 14px rgba(10, 58, 49, 0.25);
    white-space: nowrap;
  }

  /* The pill straddles the image/body seam — reserve its full height plus
     12px above the body copy so it can never sit over the first line of text. */
  .exp-card-body p {
    padding-top: 50px;
  }

  @media (min-width: 768px) {
    .exp-scroller {
      overflow: hidden; /* desktop: track position is JS-driven from page scroll, not its own scrollbar */
      scroll-snap-type: none;
    }

    .exp-card {
      flex-basis: 400px;
      max-width: 400px;
    }

    .exp-track {
      gap: 28px;
      transition: none; /* transform is set every frame from scroll-controller.js — no CSS transition fighting it */
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .exp-card,
    .exp-card-image {
      transition: none;
    }
    .exp-card:hover {
      transform: none;
    }
    .exp-card:hover .exp-card-image {
      transform: none;
    }

    @media (min-width: 768px) {
      .exp-scroller {
        overflow-x: auto;
        scroll-snap-type: x mandatory;
      }
      .exp-card {
        scroll-snap-align: start;
      }
    }
  }
</style>
