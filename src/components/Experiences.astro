---
import ResponsiveImage from "./ResponsiveImage.astro";
import { whatsapp } from "../config/links";

const cards = [
  {
    key: "corporate",
    title: "Corporate & Team",
    body: "Offsites and incentive trips that don't feel like a work trip.",
    image: "/images/exp-corporate",
    alt: "Colleagues gathered outdoors during a corporate team retreat in Southern Africa",
  },
  {
    key: "girls-trip",
    title: "Girls' Trip",
    body: "Spa days, sundowners and just enough adventure to earn the photos.",
    image: "/images/exp-girls-trip",
    alt: "Group of friends laughing together on a girls' trip getaway",
  },
  {
    key: "boys-getaway",
    title: "Boys' Getaway",
    body: "Golf, game drives and long lunches — planned so nobody has to.",
    image: "/images/exp-boys-getaway",
    alt: "Group of friends on a boys' getaway trip in Southern Africa",
  },
  {
    key: "couples",
    title: "Couples' Escape",
    body: "Quiet lodges and standout dinners, built around two people.",
    image: "/images/exp-couples",
    alt: "Couple enjoying a scenic moment together on a Southern Africa escape",
  },
  {
    key: "explore-africa",
    title: "Visiting Southern Africa",
    body: "First time in the region? We'll build the route so you see it properly.",
    image: "/images/exp-explore-africa",
    alt: "Scenic Southern African landscape showcasing the region for first-time visitors",
  },
];
---

<section id="experiences" aria-labelledby="experiences-heading" class="flex h-full flex-col justify-center bg-white py-20 md:py-0">
  <div class="mx-auto w-full max-w-content px-5 md:px-gutter">
    <p data-reveal class="reveal eyebrow">Experiences</p>
    <h2
      id="experiences-heading"
      data-reveal
      class="reveal mt-4 max-w-2xl text-h2-mobile text-green-900 tracking-tight md:text-h2-desktop"
    >
      The trip is the easy part.<br /><span class="accent-italic">The experience is what we craft.</span>
    </h2>

    <div class="mt-8 hidden h-1 w-full overflow-hidden rounded-full bg-green-900/10 md:block" role="presentation">
      <div data-experiences-progress-fill class="h-full w-full origin-left scale-x-0 bg-orange-500"></div>
    </div>

    <div class="exp-scroller mt-8 md:mt-10">
      <div data-experiences-track class="exp-track">
        {
          cards.map((card) => (
            <a
              href={whatsapp("experiences")}
              target="_blank"
              rel="noopener noreferrer"
              class="exp-card group"
            >
              <div class="overflow-hidden rounded-card">
                <ResponsiveImage
                  src={card.image}
                  alt={card.alt}
                  width={640}
                  height={480}
                  class="exp-card-image aspect-[4/3] w-full object-cover"
                  loading="lazy"
                />
              </div>
              <h3 class="mt-4 text-h3-mobile text-green-900 md:text-h3-desktop">{card.title}</h3>
              <p class="mt-1.5 text-sm text-green-700/75">{card.body}</p>
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .exp-scroller {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }

  .exp-scroller::-webkit-scrollbar {
    display: none;
  }

  .exp-track {
    display: flex;
    gap: 20px;
    width: max-content;
  }

  .exp-card {
    display: block;
    flex: 0 0 78vw;
    max-width: 340px;
    scroll-snap-align: start;
    transition: transform 500ms ease-out;
  }

  .exp-card-image {
    transition: transform 500ms ease-out;
  }

  .exp-card:hover {
    transform: translateY(-6px);
    filter: drop-shadow(0 12px 24px rgba(10, 58, 49, 0.15));
  }

  .exp-card:hover .exp-card-image {
    transform: scale(1.05);
  }

  @media (min-width: 768px) {
    .exp-scroller {
      overflow: hidden; /* desktop: track position is JS-driven from page scroll, not its own scrollbar */
      scroll-snap-type: none;
    }

    .exp-card {
      flex-basis: 400px;
      max-width: 400px;
    }

    .exp-track {
      gap: 28px;
      transition: none; /* transform is set every frame from scroll-controller.js — no CSS transition fighting it */
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .exp-card,
    .exp-card-image {
      transition: none;
    }
    .exp-card:hover {
      transform: none;
    }
    .exp-card:hover .exp-card-image {
      transform: none;
    }

    @media (min-width: 768px) {
      .exp-scroller {
        overflow-x: auto;
        scroll-snap-type: x mandatory;
      }
      .exp-card {
        scroll-snap-align: start;
      }
    }
  }
</style>
