---
import ResponsiveImage from "./ResponsiveImage.astro";
import { whatsapp } from "../config/links";

const bullets = [
  "Up to 40% off listed accommodation rates",
  "Apartments, villas, lodges, boutique hotels",
  "Vetted – we don't send you anywhere we wouldn't stay",
];
---

<section
  id="stays"
  aria-labelledby="stays-heading"
  class="relative h-[100svh] min-h-[680px] w-full overflow-hidden md:min-h-[620px]"
>
  <!-- Full-bleed image layer -->
  <div class="absolute inset-0">
    <ResponsiveImage
      src="/images/stays"
      alt="Bedroom interior with open sliding doors onto a deck, overlooking mountains and coastline"
      width={1024}
      height={1024}
      class="h-full w-full object-cover"
      loading="lazy"
      drift
    />
  </div>

  <!-- Panel layer -->
  <div
    class="relative z-10 mx-auto flex h-full max-w-content items-end px-5 pb-10 md:items-center md:px-gutter md:pb-0"
  >
    <div data-reveal data-reveal-from="left" class="reveal glass-panel w-full md:w-auto md:mr-auto">
      <p class="eyebrow">Stay</p>

      <h2 id="stays-heading" class="mt-4 text-h2-mobile text-green-900 tracking-tight md:text-h2-desktop">
        Sleep somewhere <span class="accent-italic">worth the photo.</span>
      </h2>

      <p class="mt-5 text-[15px] leading-relaxed text-green-700">
        Apartments, villas, lodges and beach houses secured below public listing prices. We match the stay to the
        trip — tell us the vibe and the budget.
      </p>

      <ul class="mt-6 flex flex-col gap-3">
        {
          bullets.map((bullet) => (
            <li class="flex items-start gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-orange-500" aria-hidden="true" />
              <span class="text-sm text-green-700 md:text-base">{bullet}</span>
            </li>
          ))
        }
      </ul>

      <a
        href={whatsapp("stays")}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-primary press mt-7 inline-flex"
      >
        Let's Book a Stay
      </a>
    </div>
  </div>
</section>
