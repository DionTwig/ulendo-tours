---
import ResponsiveImage from "./ResponsiveImage.astro";
import { whatsapp } from "../config/links";

const bullets = [
  "Up to 40% off listed accommodation rates",
  "Apartments, villas, lodges, boutique hotels",
  "Vetted – we don't send you anywhere we wouldn't stay",
];
---

<section id="stays" aria-labelledby="stays-heading" class="bg-cream-100 py-20 md:py-28">
  <div class="mx-auto max-w-content px-5 md:px-gutter">
    <div
      data-reveal
      data-reveal-from="scale"
      class="reveal relative h-[620px] overflow-hidden rounded-card md:h-[480px]"
    >
      <ResponsiveImage
        src="/images/stays"
        alt="Bedroom interior with open sliding doors onto a deck, overlooking mountains and coastline"
        width={1024}
        height={1024}
        class="absolute inset-0 h-full w-full object-cover"
        loading="lazy"
        drift
      />

      <div class="absolute inset-0 flex items-end justify-center p-5 md:items-center md:justify-start md:p-0 md:pl-16">
        <div class="frost-panel w-full md:w-auto md:max-w-[440px]">
          <p class="eyebrow">Stay</p>
          <h2 id="stays-heading" class="mt-4 text-h2-mobile text-green-900 tracking-tight md:text-h2-desktop">
            Sleep somewhere <span class="accent-italic">worth the photo.</span>
          </h2>
          <p class="mt-4 text-sm leading-[1.6] text-green-700/90">
            Apartments, villas, lodges and beach houses secured below public listing prices. We match the stay to
            the trip — tell us the vibe and the budget.
          </p>
          <ul class="mt-6 flex flex-col gap-3">
            {
              bullets.map((bullet) => (
                <li class="flex items-start gap-3">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-orange-500" aria-hidden="true" />
                  <span class="text-sm text-green-700 md:text-base">{bullet}</span>
                </li>
              ))
            }
          </ul>
          <a
            href={whatsapp("stays")}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary press mt-7 inline-flex"
          >
            Let's Book a Stay
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
