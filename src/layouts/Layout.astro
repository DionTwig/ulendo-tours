---
import "@fontsource-variable/instrument-sans/wght.css";
import "@fontsource-variable/instrument-sans/wght-italic.css";
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { links } from "../config/links";
// @ts-ignore — Vite's ?url suffix resolves to the fingerprinted asset path at build time.
import fontUrl from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  ogImagePath?: string;
}

const {
  title = "Ulendo Tours | Curated Southern Africa Travel, Johannesburg",
  description = "Ulendo Tours curates flights, stays and experiences across Southern Africa — up to 40% off, planned over WhatsApp with a Johannesburg-based team. No booking engine, just people who build the trip with you.",
  noindex = false,
  ogImagePath = "/images/hero.jpg",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogImagePath, Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["TravelAgency", "LocalBusiness"],
  name: "Ulendo Tours",
  description,
  url: "https://ulendotours.co.za",
  image: ogImage.toString(),
  priceRange: "$$",
  telephone: "+27799569295",
  email: "bookings@ulendotours.co.za",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Johannesburg",
    addressRegion: "Gauteng",
    addressCountry: "ZA",
  },
  areaServed: {
    "@type": "Place",
    name: "Southern Africa",
  },
  sameAs: [links.instagram, links.facebook],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Ulendo Tours" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0E574A" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link
      rel="preload"
      as="image"
      href="/images/hero.webp"
      fetchpriority="high"
      imagesrcset="/images/hero.webp"
    />
    <link rel="preload" as="font" type="font/woff2" href={fontUrl} crossorigin="anonymous" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body class="bg-white">
    <div id="page-loader" aria-hidden="true">
      <svg viewBox="0 0 39.2 34.98" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M23.86,34.98c-6.47,0-12.05-3.26-14.96-8.73l6.48-2.58c.43-.17.88-.26,1.34-.26,1.02,0,2,.44,2.68,1.2,1.58,1.78,3.62,2.93,5.92,3.34.74.12,1.41.12,2.07.12,3.46,0,6.88-1.46,10.17-4.35.14-.14.31-.19.59-.19.43,0,.94.39.94.88,0,.12-.04.27-.1.39-2.2,4.64-6.61,10.17-15.12,10.17Z"
        ></path>
        <path
          d="M7.87,24.6l18.88-10.04.24-.12,1.5-.84.22-.09c.85-.78,1.32-1.81,1.32-2.89,0-.44-.12-.88-.25-1.3-.62-1.78-2.49-5.88-6.64-5.88-5.21,0-7.54,5.23-7.54,10.41,0,.79.12,1.77.24,2.71,0,.1.02.19.04.27.08.33.08.49.08.66,0,1.19-.69,2.22-1.79,2.69l-6.59,3.5c-1.03-2.24-1.03-4.7-1.03-6.18C6.54,7.68,14.15,0,23.86,0c8.78,0,12.97,4.62,14.94,8.5.17.35.28.74.28,1.05.12.34.12.55.12.84,0,1.45-.81,3.22-2.62,3.88l-1.01.36L0,28.77l7.87-4.17Z"
        ></path>
      </svg>
    </div>
    <script>
      (function () {
        const loader = document.getElementById("page-loader");
        if (!loader) return;
        window.addEventListener("load", () => {
          loader.classList.add("is-loaded");
          setTimeout(() => loader.remove(), 400);
        });
      })();
    </script>
    <noscript><style>#page-loader { display: none; }</style></noscript>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-orange-500 focus:text-white focus:px-4 focus:py-2 focus:rounded-pill"
    >
      Skip to content
    </a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script src="../scripts/scroll-controller.js"></script>
    <script src="../scripts/image-drift.js"></script>
  </body>
</html>
